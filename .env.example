# ==============================================================
# CONFIGURAÇÃO DO FIREBASE (DRA. SÂMARA SOUZA - ESTÉTICA AVANÇADA)
# ==============================================================
# Obtenha estas credenciais no Firebase Console:
# 1. Acesse https://console.firebase.google.com/
# 2. Crie ou selecione seu projeto
# 3. Vá em "Configurações do Projeto" > "Geral" > "Seus aplicativos" (ícone </> Web)
# 4. Copie as chaves do objeto firebaseConfig e cole abaixo:

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ==============================================================
# CONFIGURAÇÃO DO RESEND (DISPARO REAL DE E-MAILS & ALERTAS)
# ==============================================================
# Obtenha sua API Key gratuita em https://resend.com
# 1. Crie uma conta no Resend e vá em "API Keys" -> "Create API Key"
# 2. Cole a chave abaixo no seu .env.local:
RESEND_API_KEY=

# E-mail de remetente (No modo de testes gratuito da Resend, utilize "onboarding@resend.dev"):
RESEND_FROM_EMAIL="Dra. Sâmara Souza <onboarding@resend.dev>"

# E-mail de destino padrão para onde os alertas clínicos serão despachados:
ALERT_RECIPIENT_EMAIL=samara-nagy@hotmail.com

# Segredo de autenticação para a rota Vercel Cron (/api/cron/check-alerts):
CRON_SECRET=

# ==============================================================
# SEGURANÇA: CHAVE SECRETA DE ASSINATURA JWT (HS256)
# ==============================================================
# Chave secreta de alta entropia para assinatura e validação dos tokens JWT de sessão
JWT_SECRET=sua-chave-secreta-jwt-de-alta-entropia-aqui-2026

